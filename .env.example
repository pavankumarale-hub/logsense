# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model to use for RCA generation (configurable so the project isn't tied to one tier)
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite database path (relative or absolute)
LOGSENSE_DB_PATH=logsense.db

# ── Triage tuning ──────────────────────────────────────────────────────────
DRAIN_DEPTH=4
DRAIN_SIM_THRESHOLD=0.5
DRAIN_MAX_CHILDREN=100
MIN_CLUSTER_SIZE_FOR_RCA=2

# ── Actions ────────────────────────────────────────────────────────────────
# Set to "false" to actually create GitHub issues (default: true = dry run)
LOGSENSE_DRY_RUN=true
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repo-name

# ── API server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
